# Railway sets DATABASE_URL automatically once you add a Postgres plugin
# to this service — you don't need to set it yourself.
# DATABASE_URL=postgres://user:pass@host:5432/railway

# Required: the code your team types to open the planner.
ACCESS_CODE=change-me

# Required: any long random string. Keeps everyone logged in across restarts.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too

NODE_ENV=production
